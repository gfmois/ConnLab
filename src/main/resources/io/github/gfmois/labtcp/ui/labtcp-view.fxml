<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<SplitPane dividerPositions="0.2608695652173913" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
           minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.gfmois.labtcp.ui.controller.LabTCPController">

    <!-- LEFT PANEL -->
    <VBox spacing="6.0">
        <TextField fx:id="searchField" promptText="Search configuration" style="-fx-border-style: none;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10"/>
            </padding>
        </TextField>

        <ListView fx:id="configurationsListView" VBox.vgrow="ALWAYS"/>

        <Button fx:id="changeConfigurationsPathButton" maxWidth="Infinity" text="Change Configurations Path">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10"/>
            </padding>
        </Button>
    </VBox>

    <!-- RIGHT PANEL WITH FOOTER -->
    <BorderPane>
        <center>
            <StackPane>
                <VBox
                        alignment="CENTER">
                    <Label fx:id="noConfigSelected"
                           text="No configuration selected yet">
                        <font>
                            <Font size="22"/>
                        </font>
                    </Label>
                </VBox>
                <VBox fx:id="configurationContainer" managed="false" prefHeight="418.0" prefWidth="439.0"
                      visible="false" VBox.vgrow="ALWAYS">

                    <Label fx:id="configurationSelectedName" maxWidth="Infinity">
                        <font>
                            <Font size="32.0"/>
                        </font>
                        <padding>
                            <Insets left="10" right="10" top="5"/>
                        </padding>
                    </Label>

                    <Label fx:id="configurationSelectedDescription" maxWidth="Infinity" textFill="#0000008c">
                        <font>
                            <Font size="16"/>
                        </font>
                        <padding>
                            <Insets bottom="5" left="10" right="10"/>
                        </padding>
                    </Label>

                    <VBox spacing="10" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10"/>
                        </padding>

                        <TitledPane text="Connection Settings">
                            <VBox spacing="6">
                                <CheckBox fx:id="broadcastCheckBox" text="Broadcast to all connected clients"/>
                                <CheckBox fx:id="hasToRespondCheckBox" text="Auto respond to received messages"/>
                            </VBox>
                        </TitledPane>

                        <TitledPane expanded="false" text="Messages">
                            <Label text="Messages editor coming soon..." textFill="#888"/>
                        </TitledPane>
                    </VBox>

                </VBox>
            </StackPane>
        </center>

        <bottom>
            <HBox alignment="CENTER_RIGHT" managed="false" spacing="10" visible="false" fx:id="startListeningWrapper">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10"/>
                </padding>

                <Button fx:id="startServerBtn" style="-fx-font-size: 14px; -fx-padding: 10 20;" text="Start server"
                        onAction="#onStartServerClicked"/>
                <Button fx:id="stopServerBtn" style="-fx-font-size: 14px; -fx-padding: 10 20;" text="Stop server"
                        managed="false"
                        visible="false"
                        onAction="#onStopServerClicked"
                />
            </HBox>
        </bottom>

    </BorderPane>

</SplitPane>
