<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox fx:id="configurationContainer"
      fx:controller="io.github.gfmois.labtcp.ui.controller.ConfigurationDetailsController"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="10"
      prefHeight="418.0"
      prefWidth="439.0"
      VBox.vgrow="ALWAYS"
      visible="false"
      managed="false">

    <Label fx:id="configurationSelectedName" maxWidth="Infinity">
        <font>
            <Font size="32.0"/>
        </font>
        <padding>
            <Insets left="10" right="10" top="5"/>
        </padding>
    </Label>

    <Label fx:id="configurationSelectedDescription"
           maxWidth="Infinity"
           textFill="#0000008c">
        <font>
            <Font size="16.0"/>
        </font>
        <padding>
            <Insets bottom="5" left="10" right="10"/>
        </padding>
    </Label>

    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="10" left="10" right="10" top="10"/>
        </padding>

        <TitledPane text="Connection Settings">
            <VBox spacing="6">
                <CheckBox fx:id="broadcastCheckBox"
                          text="Broadcast to all connected clients"/>
                <CheckBox fx:id="hasToRespondCheckBox"
                          text="Auto respond to received messages"/>
            </VBox>
        </TitledPane>

        <TitledPane expanded="false" text="Messages">
            <Label text="Messages editor coming soon..." textFill="#888"/>
        </TitledPane>
    </VBox>

</VBox>
