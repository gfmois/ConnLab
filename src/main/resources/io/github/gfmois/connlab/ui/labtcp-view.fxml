<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.CustomTextField?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.gfmois.connlab.ui.controller.ConnLabController">
    <center>
        <SplitPane dividerPositions="0.26">
            <!-- LEFT PANEL: configurations -->
            <VBox spacing="8.0" minWidth="230">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10"/>
                </padding>

                <CustomTextField fx:id="searchField" promptText="Search (Ctrl+F)"/>

                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Button fx:id="newConfigurationButton" text="New" onAction="#onNewConfigurationClicked"/>
                    <Button fx:id="duplicateConfigurationButton" onAction="#onDuplicateConfigurationClicked"/>
                    <Button fx:id="deleteConfigurationButton" onAction="#onDeleteConfigurationClicked"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="reloadConfigurationsButton" onAction="#onReloadConfigurationsClicked"/>
                </HBox>

                <StackPane VBox.vgrow="ALWAYS">
                    <ListView fx:id="configurationsListView"/>
                    <VBox fx:id="noConfigurationsPane" alignment="CENTER" spacing="10" visible="false" managed="false">
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10"/>
                        </padding>
                        <Label text="No configurations yet" styleClass="title-4"/>
                        <Label text="Create one, or choose the folder where you keep them." wrapText="true"
                               styleClass="text-muted" textAlignment="CENTER"/>
                        <Button text="New configuration" styleClass="accent" onAction="#onNewConfigurationClicked"/>
                    </VBox>
                </StackPane>

                <Label fx:id="configurationsPathLabel" maxWidth="Infinity" textOverrun="LEADING_ELLIPSIS"
                       styleClass="text-muted, text-small"/>
                <HBox spacing="6">
                    <Button fx:id="changeConfigurationsPathButton" text="Change folder" maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"/>
                    <Button fx:id="openConfigurationsFolder" text="Open folder" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            onAction="#onOpenConfigurationsFolderCLicked"/>
                </HBox>
            </VBox>

            <!-- RIGHT PANEL -->
            <TabPane fx:id="rightTabPane" tabClosingPolicy="UNAVAILABLE">
                <Tab text="Configuration" closable="false">
                    <BorderPane>
                        <center>
                            <StackPane>
                                <VBox alignment="CENTER">
                                    <Label fx:id="noConfigSelected" text="No configuration selected"
                                           styleClass="title-3, text-muted"/>
                                </VBox>

                                <fx:include source="configuration-details.fxml" fx:id="configurationDetails"/>
                            </StackPane>
                        </center>

                        <bottom>
                            <HBox alignment="CENTER_RIGHT" spacing="10" fx:id="startListeningWrapper"
                                  styleClass="action-bar">
                                <padding>
                                    <Insets bottom="10" left="10" right="10" top="10"/>
                                </padding>

                                <Button fx:id="startServerBtn" text="Start server" styleClass="success"
                                        onAction="#onStartServerClicked"/>
                                <Button fx:id="stopServerBtn" text="Stop server" styleClass="danger"
                                        managed="false" visible="false" onAction="#onStopServerClicked"/>
                            </HBox>
                        </bottom>
                    </BorderPane>
                </Tab>

                <Tab text="Monitor" closable="false" disable="true" fx:id="monitorTab">
                    <BorderPane>
                        <center>
                            <VBox spacing="10.0">
                                <padding>
                                    <Insets top="10.0" left="10.0" bottom="10.0" right="10.0"/>
                                </padding>

                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label fx:id="serverStatusLabel" text="Stopped" styleClass="title-4"/>
                                    <Label text="Uptime" styleClass="text-muted"/>
                                    <Label fx:id="serverUptimeLabel" text="00:00:00" styleClass="text-bold"/>
                                </HBox>

                                <TitledPane text="Clients" collapsible="false">
                                    <TableView fx:id="clientsTable" prefHeight="190.0" minHeight="150.0">
                                        <placeholder>
                                            <Label text="No clients connected" styleClass="text-muted"/>
                                        </placeholder>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                        </columnResizePolicy>
                                        <columns>
                                            <TableColumn fx:id="clientIdColumn" text="#" prefWidth="50.0"/>
                                            <TableColumn fx:id="clientAddressColumn" text="Address" prefWidth="240.0"/>
                                            <TableColumn fx:id="clientConnectedAtColumn" text="Connected at" prefWidth="120.0"/>
                                            <TableColumn fx:id="actionColumn" text="" prefWidth="100.0" sortable="false"/>
                                        </columns>
                                    </TableView>
                                </TitledPane>

                                <TitledPane text="Logs" collapsible="false" VBox.vgrow="ALWAYS" maxHeight="Infinity">
                                    <VBox spacing="6">
                                        <ListView fx:id="logsListView" VBox.vgrow="ALWAYS" styleClass="logs, dense"/>
                                        <HBox spacing="6" alignment="CENTER_LEFT">
                                            <CheckBox fx:id="followLogsCheckBox" text="Follow new lines" selected="true"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Button fx:id="copyLogsButton" text="Copy" onAction="#onCopyLogs"/>
                                            <Button fx:id="clearLogsButton" text="Clear" onAction="#onClearLogs"/>
                                        </HBox>
                                    </VBox>
                                </TitledPane>
                            </VBox>
                        </center>
                        <bottom>
                            <HBox alignment="CENTER_LEFT" spacing="10" fx:id="messageSenderWrapper" styleClass="action-bar">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>

                                <ComboBox fx:id="sendTargetComboBox" prefWidth="220"/>
                                <TextField HBox.hgrow="ALWAYS" fx:id="messageField"
                                           promptText="Write a message and press Enter" onAction="#onSend"/>
                                <Button fx:id="sendButton" text="Send" minWidth="90" styleClass="accent" onAction="#onSend"/>
                            </HBox>
                        </bottom>
                    </BorderPane>
                </Tab>
            </TabPane>
        </SplitPane>
    </center>

    <bottom>
        <HBox fx:id="statusBar" alignment="CENTER_LEFT" spacing="10" styleClass="status-bar">
            <padding>
                <Insets top="3" right="6" bottom="3" left="10"/>
            </padding>
            <Label fx:id="statusBarLabel" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="themeToggle" onAction="#onToggleTheme"/>
        </HBox>
    </bottom>
</BorderPane>
