<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<SplitPane dividerPositions="0.2608695652173913" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
           minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.gfmois.connlab.ui.controller.ConnLabController">
    <!-- LEFT PANEL -->
    <VBox spacing="6.0">
        <TextField fx:id="searchField" promptText="Search configuration" style="-fx-border-style: none;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10"/>
            </padding>
        </TextField>

        <HBox spacing="6">
            <padding>
                <Insets left="10" right="10"/>
            </padding>
            <Button text="New" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#onNewConfigurationClicked"/>
            <Button fx:id="duplicateConfigurationButton" text="Duplicate" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    onAction="#onDuplicateConfigurationClicked"/>
            <Button fx:id="deleteConfigurationButton" text="Delete" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    onAction="#onDeleteConfigurationClicked"/>
        </HBox>

        <ListView fx:id="configurationsListView" VBox.vgrow="ALWAYS"/>

        <Button fx:id="changeConfigurationsPathButton" maxWidth="Infinity" text="Change Configurations Path">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10"/>
            </padding>
        </Button>
    </VBox>

    <!-- RIGHT PANEL WITH FOOTER -->
    <TabPane fx:id="rightTabPane">
        <Tab text="Configuration" closable="false">
            <BorderPane>
                <center>
                    <StackPane>
                        <VBox alignment="CENTER">
                            <Label fx:id="noConfigSelected"
                                   text="No configuration selected yet">
                                <font>
                                    <Font size="22"/>
                                </font>
                            </Label>
                        </VBox>

                        <fx:include source="configuration-details.fxml" fx:id="configurationDetails"/>
                    </StackPane>
                </center>

                <bottom>
                    <HBox alignment="CENTER_RIGHT"  spacing="10"
                          fx:id="startListeningWrapper">
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10"/>
                        </padding>

                        <Button fx:id="openConfigurationsFolder" style="-fx-font-size: 14px; -fx-padding: 10 20;"
                                text="Open configurations folder"
                                onAction="#onOpenConfigurationsFolderCLicked"/>
                        <Button fx:id="startServerBtn" style="-fx-font-size: 14px; -fx-padding: 10 20;"
                                text="Start server"
                                onAction="#onStartServerClicked"/>
                        <Button fx:id="stopServerBtn" style="-fx-font-size: 14px; -fx-padding: 10 20;"
                                text="Stop server"
                                managed="false"
                                visible="false"
                                onAction="#onStopServerClicked"
                        />
                    </HBox>
                </bottom>

            </BorderPane>
        </Tab>

        <Tab text="Monitor" closable="false" disable="true" fx:id="monitorTab">
            <BorderPane>
                <center>
                    <VBox spacing="8.0">
                        <padding>
                            <Insets top="10.0" left="10.0" bottom="10.0" right="10.0"/>
                        </padding>

                        <Label text="Server Monitor">
                            <font>
                                <Font size="18.0"/>
                            </font>
                        </Label>

                        <HBox spacing="10">
                            <Label text="Status:"/>
                            <Label fx:id="serverStatusLabel" text="STOPPED"/>
                            <Label text="Uptime:"/>
                            <Label fx:id="serverUptimeLabel" text="00:00:00"/>
                        </HBox>

                        <TitledPane text="Clients">
                            <TableView fx:id="clientsTable" prefHeight="120.0">
                                <columns>
                                    <TableColumn fx:id="clientIdColumn" text="ID" prefWidth="150.0"/>
                                    <TableColumn fx:id="clientAddressColumn" text="Address" prefWidth="250.0"/>
                                    <TableColumn fx:id="actionColumn" text="Actions" prefWidth="250.0"/>
                                </columns>
                            </TableView>
                        </TitledPane>

                        <TitledPane text="Logs" VBox.vgrow="ALWAYS">
                            <ListView fx:id="logsListView" VBox.vgrow="ALWAYS"/>
                        </TitledPane>
                    </VBox>
                </center>
                <bottom>
                    <HBox alignment="CENTER_LEFT" spacing="10" fx:id="messageSenderWrapper">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>

                        <TextField HBox.hgrow="ALWAYS" fx:id="messageField" promptText="Write a broadcast message"
                                   onAction="#onSend"/>

                        <Button text="Send" minWidth="90" onAction="#onSend"/>
                    </HBox>
                </bottom>
            </BorderPane>
        </Tab>
    </TabPane>
</SplitPane>
