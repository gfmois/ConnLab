<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="configurationContainer" spacing="0" VBox.vgrow="ALWAYS" styleClass="configuration-editor"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.gfmois.connlab.ui.controller.ConfigurationDetailsController">

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="editor-toolbar">
        <padding>
            <Insets bottom="8" left="10" right="10" top="8"/>
        </padding>
        <Label fx:id="statusLabel" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="editor-status"/>
        <Button fx:id="discardButton" text="Discard changes" onAction="#onDiscard" disable="true" styleClass="flat"/>
        <Button fx:id="saveButton" text="Save" onAction="#onSave" disable="true" styleClass="accent">
            <tooltip>
                <Tooltip text="Save to the JSON file (Ctrl+S)"/>
            </tooltip>
        </Button>
    </HBox>

    <Label fx:id="errorsLabel" maxWidth="Infinity" wrapText="true" styleClass="editor-errors"
           visible="false" managed="false"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="editor-scroll">
        <VBox spacing="12">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10"/>
            </padding>

            <TextField fx:id="nameField" promptText="Configuration name" styleClass="config-name-field"/>
            <TextField fx:id="descriptionField" promptText="Description (optional)"/>
            <Label fx:id="fileLabel" styleClass="message-meta"/>

            <TitledPane text="Connection" collapsible="false">
                <VBox spacing="10">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Host:"/>
                        <TextField fx:id="hostField" promptText="0.0.0.0 (all interfaces)" prefColumnCount="14"/>
                        <Label text="Port:"/>
                        <TextField fx:id="portField" promptText="6969" prefColumnCount="6"/>
                    </HBox>
                    <CheckBox fx:id="hasToRespondCheckBox" text="Auto respond to received messages"/>
                </VBox>
            </TitledPane>

            <TitledPane text="Messages" collapsible="false">
                <VBox spacing="10">
                    <Label fx:id="noMessagesLabel" text="This configuration has no messages defined"
                           styleClass="message-meta"/>
                    <VBox fx:id="messagesBox" spacing="10"/>
                    <Button text="Add message" onAction="#onAddMessage"/>
                </VBox>
            </TitledPane>

            <TitledPane text="Try it" collapsible="false">
                <VBox spacing="6">
                    <TextField fx:id="tryField" promptText="Type a message a client could send, e.g. Hello, Juan"/>
                    <Label fx:id="tryResultLabel" wrapText="true" styleClass="try-result"/>
                </VBox>
            </TitledPane>
        </VBox>
    </ScrollPane>
</VBox>
